# —— Database (optional for fixture UI) ——
# App runs without this; set to enable live sync / connection status.
DATABASE_URL=postgresql://monday:monday@localhost:5432/monday_brief

# —— App session ——
# Used for OAuth state cookies and future token encryption key derivation.
# Generate: openssl rand -base64 32
SESSION_SECRET=replace-with-long-random-string

# Optional NextAuth-compatible alias (not required)
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000

# —— Clerk auth (Phase 1) ——
# Dashboard: enable Organizations. Build placeholders exist; set real keys on Vercel.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/brief
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/brief

# —— Token encryption (AES-256-GCM) ——
# Generate: openssl rand -base64 32
# Old stub-v1 tokens will not decrypt — re-connect OAuth after setting this.
TOKEN_ENCRYPTION_KEY=

# —— Jobs / Vercel cron ——
# POST /api/jobs/drain with Authorization: Bearer <CRON_SECRET>
CRON_SECRET=


# —— Harvest OAuth ——
# Create app: https://id.getharvest.com/developers
# Without these, Connect → friendly "configure env" page (no fake credentials).
HARVEST_CLIENT_ID=
HARVEST_CLIENT_SECRET=
HARVEST_REDIRECT_URI=http://localhost:3000/api/auth/harvest/callback
# Optional fallback if accounts endpoint is unavailable after OAuth
# HARVEST_ACCOUNT_ID=
# User-Agent required by Harvest API (app name + contact)
# HARVEST_USER_AGENT=MondayProfitBrief (you@example.com)

# —— QuickBooks Online (Intuit) OAuth ——
# Create app: https://developer.intuit.com/app/developer/dashboard
# Scope: com.intuit.quickbooks.accounting
# Without these, Connect → friendly "configure env" page.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/api/auth/qbo/callback
# sandbox | production
QBO_ENVIRONMENT=sandbox
# realmId is stored on the token row from OAuth callback (?realmId=).
# Optional override only if you must force a company without reconnecting:
# QBO_REALM_ID=

# —— Sync freshness ——
# Prefer live DB-synced data when last sync is newer than this many hours
SYNC_FRESHNESS_HOURS=168

# —— Public app URL (OAuth absolute redirects) ——
APP_BASE_URL=http://localhost:3000

# —— Stripe billing ($49/mo Kamo) ——
# Create Product + recurring Price in Dashboard (see GO-LIVE.md). Copy Price ID here.
# Without these, CTAs show "Configure Stripe" / demo mode — app never crashes.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
# $149 Studio tier (Brief + extra RFO rituals)
STRIPE_PRICE_ID_STUDIO=
STRIPE_WEBHOOK_SECRET=
# Dev only: allow unsigned webhook JSON when secret unset (never in production)
# STRIPE_WEBHOOK_ALLOW_UNSIGNED=1
# APP_BASE_URL already listed above — used for Checkout success/cancel + Portal return

# —— RFO orchestration (Spike 1) ——
# Slack Incoming Webhook for margin-risk / exception notifies
SLACK_WEBHOOK_URL=
# Destination email for exception notifies (requires RESEND_API_KEY to actually send)
NOTIFY_EMAIL=
# Optional Resend API key — without it, email notify dry-runs with a clear message
# RESEND_API_KEY=
# Optional From: address for Resend
RFO_FROM_EMAIL=
# Gross margin below this → margin_risk exception (0.2 = 20%). Also flags laborCost > revenue.
MARGIN_RISK_THRESHOLD=0.2
